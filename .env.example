# Copy to .env.local for local development. Values below fit the local Data Hub from
# ../unternehmensdatenbank; staging and prod set the same variables on the platform.

# This app's public URL (the Keycloak client only accepts redirects to it).
NEXTAUTH_URL=http://localhost:3100
# Encrypts the session cookie: openssl rand -base64 32
NEXTAUTH_SECRET=

# Realm URL. Must match the issuer in Keycloak's tokens.
KEYCLOAK_ISSUER=http://localhost:8180/realms/datahub
KEYCLOAK_CLIENT_ID=unternehmensdaten-app
# Locally: the client's "secret" in keycloak/datahub-realm.json in ../unternehmensdatenbank.
KEYCLOAK_CLIENT_SECRET=

# Hasura's GraphQL endpoint.
HASURA_GRAPHQL_URL=http://localhost:8090/v1/graphql
